generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  CANCELLED
}

enum ProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

enum Gender {
  HOMME
  FEMME
  MIXTE
}

model User {
  id                 String             @id @default(cuid())
  email              String             @unique
  phone              String?            @unique
  passwordHash       String
  role               Role               @default(USER)
  emailVerified      Boolean            @default(false)
  verificationToken  String?            @unique
  verificationExpiry DateTime?
  resetToken         String?            @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  profile            Profile?
  subscription       Subscription?
  sentMessages       Message[]          @relation("sender")
  receivedMessages   Message[]          @relation("receiver")
  favorites          Favorite[]
  reviews            Review[]
  notifications      Notification[]
  reports            Report[]           @relation("reporter")
  pushSubscriptions  PushSubscription[]
  payments           Payment[]
  stripeCustomerId   String?
  fedapayCustomerId  String?
  referralCode       String?            @unique
  referredById       String?
  referredBy         User?              @relation("Referrals", fields: [referredById], references: [id])
  referrals          User[]             @relation("Referrals")
  referralRewards    ReferralReward[]
}

model Profile {
  id                   String                @id @default(cuid())
  userId               String                @unique
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName          String
  age                  Int
  city                 String
  country              String                @default("BJ")
  gender               Gender?
  bio                  String?
  phone                String?
  pricePerHour         Float?
  categories           String[]
  tags                 String[]
  isVerified           Boolean               @default(false)
  isOnline             Boolean               @default(false)
  isPrivate            Boolean               @default(false)
  latitude             Float?
  longitude            Float?
  status               ProfileStatus         @default(PENDING)
  viewCount            Int                   @default(0)
  photos               Photo[]
  videos               Video[]
  reviews              Review[]
  favoritedBy          Favorite[]
  reports              Report[]
  boosts               Boost[]
  availabilities       Availability[]
  identityVerification IdentityVerification?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

model Photo {
  id               String           @id @default(cuid())
  profileId        String
  profile          Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url              String
  publicId         String
  isMain           Boolean          @default(false)
  isPrivate        Boolean          @default(false)
  moderationStatus ModerationStatus @default(PENDING)
  moderationNote   String?
  createdAt        DateTime         @default(now())
}

model Video {
  id               String           @id @default(cuid())
  profileId        String
  profile          Profile          @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url              String
  publicId         String
  thumbnailUrl     String?
  duration         Float?
  isMain           Boolean          @default(false)
  isPrivate        Boolean          @default(false)
  moderationStatus ModerationStatus @default(PENDING)
  moderationNote   String?
  createdAt        DateTime         @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Boost {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plan      BoostPlan
  startAt   DateTime  @default(now())
  endAt     DateTime
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

enum BoostPlan {
  DAY
  WEEK
  MONTH
}

model Report {
  id         String       @id @default(cuid())
  reporterId String
  reporter   User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  profileId  String
  profile    Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reason     ReportReason
  details    String?
  status     ReportStatus @default(PENDING)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
}

enum ReportReason {
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  SCAM
  UNDERAGE
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ModerationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  MESSAGE
  REVIEW
  FAVORITE
  SYSTEM
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  sender     User     @relation("sender", fields: [senderId], references: [id])
  receiver   User     @relation("receiver", fields: [receiverId], references: [id])
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  status               SubscriptionStatus @default(TRIAL)
  plan                 String
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  profileId  String
  userId     String
  profile    Profile  @relation(fields: [profileId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  rating     Int
  comment    String?
  isVerified Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([profileId, userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  user      User     @relation(fields: [userId], references: [id])
  profile   Profile  @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, profileId])
}

model Availability {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek Int
  startTime String
  endTime   String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dayOfWeek])
}

model IdentityVerification {
  id          String      @id @default(cuid())
  profileId   String      @unique
  profile     Profile     @relation(fields: [profileId], references: [id], onDelete: Cascade)
  docType     String
  docFrontUrl String
  docBackUrl  String?
  selfieUrl   String
  status      VerifStatus @default(PENDING)
  note        String?
  submittedAt DateTime    @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
}

enum VerifStatus {
  PENDING
  APPROVED
  REJECTED
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model Payment {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation(fields: [userId], references: [id])
  amount      Int
  currency    String      @default("XOF")
  provider    PayProvider
  providerRef String?
  purpose     PayPurpose
  plan        String?
  status      PayStatus   @default(PENDING)
  metadata    Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

enum PayProvider {
  STRIPE
  FEDAPAY
}

enum PayPurpose {
  SUBSCRIPTION
  BOOST
}

enum PayStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model ReferralReward {
  id          String       @id @default(cuid())
  userId      String
  user        User         @relation(fields: [userId], references: [id])
  referredId  String
  type        RewardType
  status      RewardStatus @default(PENDING)
  description String
  appliedAt   DateTime?
  createdAt   DateTime     @default(now())
}

enum RewardType {
  FREE_BOOST_DAY
  DISCOUNT_PERCENT
  FREE_PREMIUM_DAY
  CASH_CREDIT
}

enum RewardStatus {
  PENDING
  APPLIED
  EXPIRED
}
