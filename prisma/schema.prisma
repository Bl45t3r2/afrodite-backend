generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  PREMIUM
  ADMIN
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  TRIAL
  CANCELLED
}

enum ProfileStatus {
  PENDING
  ACTIVE
  SUSPENDED
  BANNED
}

model User {
  id                  String             @id @default(cuid())
  email               String             @unique
  phone               String?            @unique
  passwordHash        String
  role                Role               @default(USER)
  emailVerified       Boolean            @default(false)
  verificationToken   String?            @unique
  verificationExpiry  DateTime?
  resetToken          String?            @unique
  resetTokenExpiry    DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  profile             Profile?
  subscription        Subscription?
  sentMessages        Message[]          @relation("sender")
  receivedMessages    Message[]          @relation("receiver")
  favorites           Favorite[]
  reviews             Review[]
  notifications       Notification[]
  reports             Report[]       @relation("reporter")
  pushSubscriptions   PushSubscription[]
  payments            Payment[]
  stripeCustomerId    String?
  fedapayCustomerId   String?
  referralCode        String?            @unique // code de parrainage unique
  referredById        String?            // userId du parrain
  referredBy          User?              @relation("Referrals", fields: [referredById], references: [id])
  referrals           User[]             @relation("Referrals")
  referralRewards     ReferralReward[]
}

model Profile {
  id           String        @id @default(cuid())
  userId       String        @unique
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName  String
  age          Int
  city         String
  country      String        @default("BJ")
  bio          String?
  phone        String?
  pricePerHour Float?
  categories   String[]
  tags         String[]
  isVerified   Boolean       @default(false)
  isOnline     Boolean       @default(false)
  latitude     Float?        // coordonnées GPS
  longitude    Float?
  status       ProfileStatus @default(PENDING)
  viewCount    Int           @default(0)
  photos       Photo[]
  videos       Video[]
  reviews      Review[]
  favoritedBy  Favorite[]
  reports      Report[]
  boosts         Boost[]
  availabilities       Availability[]
  identityVerification IdentityVerification?
  createdAt            DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Photo {
  id               String          @id @default(cuid())
  profileId        String
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url              String
  publicId         String
  isMain           Boolean         @default(false)
  isPrivate        Boolean         @default(false)
  moderationStatus ModerationStatus @default(PENDING)
  moderationNote   String?
  createdAt        DateTime        @default(now())
}

model Video {
  id               String          @id @default(cuid())
  profileId        String
  profile          Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  url              String
  publicId         String
  thumbnailUrl     String?
  duration         Float?
  isMain           Boolean         @default(false)
  isPrivate        Boolean         @default(false)
  moderationStatus ModerationStatus @default(PENDING)
  moderationNote   String?
  createdAt        DateTime        @default(now())
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String
  link      String?
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model Boost {
  id        String    @id @default(cuid())
  profileId String
  profile   Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  plan      BoostPlan
  startAt   DateTime  @default(now())
  endAt     DateTime
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
}

enum BoostPlan {
  DAY
  WEEK
  MONTH
}

model Report {
  id          String       @id @default(cuid())
  reporterId  String
  reporter    User         @relation("reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  profileId   String
  profile     Profile      @relation(fields: [profileId], references: [id], onDelete: Cascade)
  reason      ReportReason
  details     String?
  status      ReportStatus @default(PENDING)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

enum ReportReason {
  FAKE_PROFILE
  INAPPROPRIATE_CONTENT
  SCAM
  UNDERAGE
  SPAM
  OTHER
}

enum ReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTION_TAKEN
}

enum ModerationStatus {
  PENDING   // En attente de validation
  APPROVED  // Validée
  REJECTED  // Refusée
}

enum NotificationType {
  MESSAGE
  REVIEW
  FAVORITE
  SYSTEM
}

model Message {
  id          String   @id @default(cuid())
  senderId    String
  receiverId  String
  sender      User     @relation("sender", fields: [senderId], references: [id])
  receiver    User     @relation("receiver", fields: [receiverId], references: [id])
  content     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id])
  status               SubscriptionStatus @default(TRIAL)
  plan                 String             // "basic" | "premium" | "vip"
  stripeSubscriptionId String?
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Review {
  id         String   @id @default(cuid())
  profileId  String
  userId     String
  profile    Profile  @relation(fields: [profileId], references: [id])
  user       User     @relation(fields: [userId], references: [id])
  rating     Int      // 1-5
  comment    String?
  isVerified Boolean  @default(false) // true si l'auteur a échangé des messages avec ce profil
  createdAt  DateTime @default(now())

  @@unique([profileId, userId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  profileId String
  user      User     @relation(fields: [userId], references: [id])
  profile   Profile  @relation(fields: [profileId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, profileId])
}

model Availability {
  id        String   @id @default(cuid())
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  dayOfWeek Int      // 0=Dimanche, 1=Lundi ... 6=Samedi
  startTime String   // "HH:MM" ex: "09:00"
  endTime   String   // "HH:MM" ex: "18:00"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([profileId, dayOfWeek])
}

model IdentityVerification {
  id          String             @id @default(cuid())
  profileId   String             @unique
  profile     Profile            @relation(fields: [profileId], references: [id], onDelete: Cascade)
  docType     String             // 'CNI' | 'PASSEPORT' | 'PERMIS'
  docFrontUrl String             // Photo recto du document
  docBackUrl  String?            // Photo verso (optionnel)
  selfieUrl   String             // Selfie avec le document
  status      VerifStatus        @default(PENDING)
  note        String?            // Note de l'admin
  submittedAt DateTime           @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?            // userId de l'admin
}

enum VerifStatus {
  PENDING
  APPROVED
  REJECTED
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())
}

model Payment {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  amount          Int           // en centimes FCFA
  currency        String        @default("XOF")
  provider        PayProvider   // STRIPE | FEDAPAY
  providerRef     String?       // ID de la transaction chez le provider
  purpose         PayPurpose    // SUBSCRIPTION | BOOST
  plan            String?       // 'premium' | 'vip' | 'DAY' | 'WEEK' | 'MONTH'
  status          PayStatus     @default(PENDING)
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

enum PayProvider {
  STRIPE
  FEDAPAY
}

enum PayPurpose {
  SUBSCRIPTION
  BOOST
}

enum PayStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model ReferralReward {
  id          String       @id @default(cuid())
  userId      String       // bénéficiaire de la récompense
  user        User         @relation(fields: [userId], references: [id])
  referredId  String       // l'utilisateur parrainé
  type        RewardType
  status      RewardStatus @default(PENDING)
  description String
  appliedAt   DateTime?
  createdAt   DateTime     @default(now())
}

enum RewardType {
  FREE_BOOST_DAY     // 1 jour de boost gratuit
  DISCOUNT_PERCENT   // % de réduction sur abonnement
  FREE_PREMIUM_DAY   // 1 jour de premium gratuit
  CASH_CREDIT        // crédit en FCFA
}

enum RewardStatus {
  PENDING   // en attente que le filleul s'abonne
  APPLIED   // récompense activée
  EXPIRED   // expirée sans activation
}
